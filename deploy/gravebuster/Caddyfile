:80 {
    log {
        output stdout
        format console
    }

    # Container liveness responder
    handle /healthz {
        respond "OK" 200
    }

    # Proxy API and server health endpoints to the Node service
    handle /api/* {
        reverse_proxy octo-api:3001
    }

    handle /health {
        reverse_proxy octo-api:3001
    }

    # OAuth 2.1 authorization server for the remote MCP endpoint. A custom MCP
    # client (ChatGPT, ...) discovers these from the 401 challenge on /mcp:
    # the protected-resource and authorization-server metadata, the dynamic
    # client registration endpoint, and the authorize/token endpoints.
    handle /.well-known/* {
        reverse_proxy octo-api:3001
    }

    handle /oauth/* {
        reverse_proxy octo-api:3001
    }

    # Remote MCP endpoint (Streamable HTTP) for hosted clients such as ChatGPT.
    # /mcp authenticates with a bearer key or an OAuth access token; /mcp/<key>
    # is retired and answers 404 (a long-lived key no longer belongs in a URL).
    handle /mcp* {
        reverse_proxy octo-api:3001
    }

    # /v2 without the trailing slash would otherwise fall through to the v1 SPA
    # catch-all; send it to the mount so the app's relative asset base resolves.
    redir /v2 /v2/ 301

    # Second UI build, mounted alongside v1 at /. It carries its own design system
    # and is served from the same root; the SPA fallback stays inside /v2 so it
    # cannot swallow v1 routes.
    handle /v2/* {
        root * /srv
        file_server
        try_files {path} /v2/index.html
    }

    # Static Vite build with SPA routing fallback
    handle {
        root * /srv
        file_server
        try_files {path} /index.html
    }
}
