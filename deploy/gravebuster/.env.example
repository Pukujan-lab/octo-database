# Octo Production Environment Configuration (Gravebuster)
# Copy to .env on gravebuster (never commit secrets to git).

# Base Public URL
PUBLIC_BASE_URL=https://octodb.design-bakery.com
# Local web port exposed on gravebuster (8091 is default since 8090 is taken by groktocrawl)
WEB_HOST_PORT=8091

# PostgreSQL Database (points to internal octo-db service container)
POSTGRES_PASSWORD=generate_a_secure_password_here
# Schema-owner connection: used by migrations and one-time maintenance only.
DATABASE_URL=postgresql://postgres:generate_a_secure_password_here@octo-db:5432/postgres

# Runtime roles (Slice 14 key-scope isolation fence). Apply the Slice 14 migration
# to the live database first, then set each role's password out-of-band and point
# the two runtime connections here. `octo_app` is RLS-enforced (the request path);
# `octo_service` is BYPASSRLS (the small trusted surface). Until these are set the
# server falls back to DATABASE_URL and RLS stays dormant.
OCTO_DB_URL=postgresql://octo_app:generate_a_secure_password_here@octo-db:5432/postgres
OCTO_SERVICE_URL=postgresql://octo_service:generate_a_secure_password_here@octo-db:5432/postgres

# Privileged connection for provisioning per-workspace databases (Slice 20). It
# needs CREATE DATABASE / CREATE ROLE, which octo_app and octo_service deliberately
# lack. Set the password out-of-band and never commit it. Unset leaves
# POST /api/workspaces/{id}/database failing with PROVISIONING_NOT_CONFIGURED.
OCTO_ADMIN_URL=postgresql://postgres:generate_a_secure_password_here@octo-db:5432/postgres

# How a client reaches its provisioned database (Slice 20). The one-time
# connection string is built from these, because the admin connection reaches
# Postgres by the compose-internal name `octo-db`, which nothing outside this
# stack resolves.
#
# The port is published on loopback (docker-compose.yml) and Tailscale forwards it
# to the tailnet only, so the cluster -- control plane included -- is never exposed
# to the local network. On the host, once:
#     tailscale serve --bg --tcp 5432 tcp://127.0.0.1:5432
# Publishing on a host address instead (OCTO_DB_PUBLISH_ADDR=0.0.0.0) would skip
# that forwarder, and would expose the cluster to every interface: Docker's port
# rules sit ahead of the host firewall.
OCTO_DB_PUBLIC_HOST=gravebuster.tail733a0f.ts.net
OCTO_DB_PUBLIC_PORT=5432

# Google OAuth Credentials
# Note: Reuses existing Google OAuth Client ID / Secret from Google Cloud Console.
# Ensure https://octodb.design-bakery.com/api/auth/google/callback is registered as authorized redirect URI.
GOOGLE_OAUTH_CLIENT_ID=your-google-oauth-client-id.apps.googleusercontent.com
GOOGLE_OAUTH_CLIENT_SECRET=GOCSPX-your-google-oauth-client-secret

# Cloudflare Turnstile ("are you a bot") on the guest-login button. Create a
# Managed widget at dash.cloudflare.com -> Turnstile for octodb.design-bakery.com,
# then paste both values. Leave TURNSTILE_SECRET_KEY unset to skip the check.
TURNSTILE_SITE_KEY=0x4AAAAAAA-your-site-key
TURNSTILE_SECRET_KEY=0x4AAAAAAA-your-secret-key

# Email address that signs in as the platform owner. A principal whose verified
# Google email matches this is granted is_platform_owner: full access to every
# workspace and exemption from the Slice 16 one-workspace-per-day creation limit.
# Leave unset and the owner is treated as an ordinary principal (and gets 429'd
# on their second workspace of the day).
PLATFORM_OWNER_EMAIL=owner@example.com

# Media Security Key (used to cryptographically sign thumbnail and share URLs)
OCTO_MEDIA_SECRET=generate_a_random_32_byte_hex_secret_here

# Session token signing key (ISS-1). Signs the bearer session tokens minted at
# guest/OAuth login. Unset falls back to a per-process secret that invalidates all
# sessions on restart, so set it in any long-running deployment.
OCTO_SESSION_SECRET=generate_a_random_32_byte_hex_secret_here

# OAuth access token signing key (MCP authorization server). Signs the OAuth 2.1
# access tokens minted by the /oauth/token endpoint for remote MCP clients such
# as ChatGPT. Unset falls back to a per-process secret that invalidates every
# issued MCP token on restart, so set it wherever /mcp is served over OAuth.
OCTO_OAUTH_SECRET=generate_a_random_32_byte_hex_secret_here

# Envelope key for stored secrets (Slice 17 MFA, Slice 21 workspace-database
# credentials). AES-256-GCM, keyed from this value. Unset disables MFA enrollment
# and leaves POST /api/workspaces/{id}/query rotating a fresh database password on
# every call -- which also invalidates any connection string returned by
# provisioning. Set it in any deployment that uses either surface.
OCTO_MFA_SECRET=generate_a_random_32_byte_hex_secret_here

# Session lifetime in seconds. Defaults to 1200 (20 minutes) when unset. Raise it to
# keep sessions alive longer; the client also locks after 20 minutes idle.
OCTO_SESSION_TTL_SECONDS=

# Storage Backend (R2 is production default)
#
# These names are the ones src/storage/r2-client.ts loadR2ConfigFromEnv actually
# reads. An R2 access key ID / secret pair goes with the account's S3 endpoint.
# Setting OCTO_STORAGE_BACKEND=local instead stores bytes on local disk (CI/dev
# only) and ignores everything below.
OCTO_STORAGE_BACKEND=r2
R2_ENDPOINT=https://your-cloudflare-account-id.r2.cloudflarestorage.com
R2_ACCESS_KEY_ID=your-r2-access-key-id
R2_SECRET_ACCESS_KEY=your-r2-secret-access-key
OCTO_R2_BUCKET=octo
# Second bucket for files a site explicitly publishes. Configure the custom
# domain in Cloudflare. Do not set this to the private bucket above.
OCTO_PUBLIC_R2_BUCKET=
OCTO_PUBLIC_FILES_BASE=https://files.example.com

# Google Drive (Cold Archival Tier)
GOOGLE_DRIVE_FOLDER_ID=your-google-drive-folder-id
GOOGLE_DRIVE_REFRESH_TOKEN=your-google-drive-refresh-token

# FalkorDB graph engine (issue #12). One graph per workspace, reachable only through
# Octo's mediated API/MCP -- the container publishes no port, so the only way to a
# graph is through a route that derives the graph name from the authenticated
# workspace. requirepass is an access gate, not a tenant boundary: anyone holding it
# can query every graph, so it stays inside the octo_internal network.
OCTO_GRAPH_PASSWORD=generate_a_secure_password_here

# How octo-api reaches the graph (compose-internal name; nothing outside resolves
# it). Unset leaves the graph surface returning 503 GRAPH_NOT_CONFIGURED, the same
# shape as the embedding provider. The password must match OCTO_GRAPH_PASSWORD.
OCTO_GRAPH_URL=redis://:generate_a_secure_password_here@octo-graph:6379

# In-memory engine bounds. OCTO_GRAPH_MEMORY_LIMIT caps the container;
# OCTO_GRAPH_MAXMEMORY is the engine's own limit, set below the cap so it refuses
# writes and degrades instead of being OOM-killed. A graph is a rebuildable
# projection of Postgres, so neither bounds durability.
OCTO_GRAPH_MEMORY_LIMIT=1g
OCTO_GRAPH_MAXMEMORY=768mb

# Embeddings for retrieval (Slice 8). Any [OI]-compatible provider.
# Unset leaves POST /api/rag/documents and POST /api/rag/query returning 503
# EMBEDDING_PROVIDER_NOT_CONFIGURED -- the one query-shaped surface the server
# exposes. The InferHub gateway has no embeddings route, so this needs its own
# provider. A local keyless server (Ollama, llama.cpp, TEI) is supported: leave the
# key empty and set the base URL. Dimensions must match the stored width, halfvec(512)
# (#386); longer provider vectors are cut to it and re-normalized.
# Inside the container the host is host.docker.internal; a host-side run uses
# http://localhost:11434/v1 instead.
OCTO_EMBEDDING_API_KEY=
OCTO_EMBEDDING_BASE_URL=http://host.docker.internal:11434/v1
OCTO_EMBEDDING_MODEL=qwen3-embedding:0.6b
OCTO_EMBEDDING_DIMENSIONS=512

# UX analytics (#400): the self-hosted Umami (Komodo stack `umami` in
# Pukujan-lab/server-management). Unset leaves /api/workspaces/<id>/ux-analytics
# returning 503 and the Services page showing it as not set up.
OCTO_UMAMI_PUBLIC_URL=https://umami.design-bakery.com
OCTO_UMAMI_ADMIN_PASSWORD=
