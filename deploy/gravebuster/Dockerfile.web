# Multi-stage Dockerfile for octo-web (Vite build + Caddy static server/reverse proxy)
FROM node:22-bookworm-slim AS builder
WORKDIR /app

COPY package.json package-lock.json ./
# Both apps are built from their own directory, each carrying its own dependency
# tree; the root install alone would not pull either in. `.npmrc` must come along
# too: it sets legacy-peer-deps, without which the installs fail on peers.
COPY frontend/package.json frontend/package-lock.json frontend/.npmrc ./frontend/
COPY frontend-v2/package.json frontend-v2/package-lock.json frontend-v2/.npmrc ./frontend-v2/
RUN npm ci && npm --prefix frontend ci && npm --prefix frontend-v2 ci

COPY . .
RUN npm run build

FROM caddy:2-alpine
COPY --from=builder /app/dist /srv
COPY deploy/gravebuster/Caddyfile /etc/caddy/Caddyfile

EXPOSE 80
CMD ["caddy", "run", "--config", "/etc/caddy/Caddyfile", "--adapter", "caddyfile"]
