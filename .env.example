# Names only. Keep values blank in Git.
# Runtime configuration for Octo. Copy to `.env` (gitignored) and fill locally.

# --- Canonical PostgreSQL (octo schema) ---
# Migrations, maintenance scripts, and local dev connect as the schema owner here.
DATABASE_URL=

# --- Runtime roles (Slice 14 key-scope isolation fence) ---
# The server runs two roles: `octo_app` (RLS-enforced request path) and
# `octo_service` (BYPASSRLS trusted surface: login/bootstrap, the job worker,
# server-owned jobs/activity writes). Both are created by the Slice 14 migration;
# set their passwords out-of-band (`ALTER ROLE ... PASSWORD ...`) and point these
# here. Leave both unset to fall back to DATABASE_URL (single-connection local dev/CI).
OCTO_DB_URL=
OCTO_SERVICE_URL=

# --- Provisioned per-workspace databases (productization Slice 20) ---
# The privileged connection that can CREATE DATABASE / CREATE ROLE cluster-wide.
# `octo_app` and `octo_service` deliberately cannot (NOCREATEDB / NOCREATEROLE),
# so provisioning needs its own credential. Unset leaves
# POST /api/workspaces/{id}/database failing with PROVISIONING_NOT_CONFIGURED.
OCTO_ADMIN_URL=
# Optional: the host/port a client should use in the returned connection string,
# when that differs from the admin connection's own endpoint (for example a
# published port). Unset uses the admin connection's host and port.
OCTO_DB_PUBLIC_HOST=
OCTO_DB_PUBLIC_PORT=

# --- Cloudflare R2 active storage (read by src/storage/r2-client.ts) ---
# The loader accepts either naming; set one pair, not both.
S3_API_ENDPOINT=
ACCESS_KEY_ID=
CLOUDFLARE_SECRET_ACCESS_KEY=
# Accepted aliases: R2_ENDPOINT, R2_ACCESS_KEY_ID, R2_SECRET_ACCESS_KEY
OCTO_R2_BUCKET=octo
# Public website files (issue #175). A second R2 bucket, fronted by a Cloudflare
# custom domain that you configure in Cloudflare. Leave the bucket unset to
# disable publish. Never point it at the private bucket above. Local storage
# (OCTO_STORAGE_BACKEND=local) ignores the bucket and serves /public/files/<id>.
OCTO_PUBLIC_R2_BUCKET=
OCTO_PUBLIC_FILES_BASE=https://files.example.com

# --- Server ---
PORT=3001

# Storage backend. Leave unset for R2 (production). Set to `local` only for
# CI/dev so uploads land in /tmp/octo-storage instead of failing closed.
OCTO_STORAGE_BACKEND=

# --- MFA secret envelope (Slice 17) ---
# Key material for the AES-256-GCM envelope that encrypts each principal's TOTP
# secret at rest, and (Slice 21) each workspace database role's password. Enrolling
# an authenticator requires it; unset leaves MFA enrollment returning
# MFA_NOT_CONFIGURED. Unset also leaves the SQL surface
# (POST /api/workspaces/{id}/query) rotating a fresh database password on every
# call, which invalidates any connection string provisioning returned.
OCTO_MFA_SECRET=

# --- Session token signing (ISS-1) ---
# HMAC key for the signed, expiring bearer session tokens minted at guest/OAuth
# login. Unset falls back to a per-process random secret, which invalidates every
# session on restart, so self-hosted deployments should set it.
OCTO_SESSION_SECRET=

# --- OAuth access token signing (MCP authorization server) ---
# HMAC key for the OAuth 2.1 access tokens the /mcp authorization server mints
# (authorization-code + PKCE). Unset falls back to a per-process random secret,
# which invalidates every issued MCP token on restart, so set it in any
# deployment that serves /mcp over OAuth.
OCTO_OAUTH_SECRET=

# Session lifetime in seconds. Defaults to 1200 (20 minutes) when unset. Raise it to
# keep sessions alive longer; the client also locks after 20 minutes idle.
OCTO_SESSION_TTL_SECONDS=

# --- Google Drive cold archival (Slice 5 / #7) ---
# Server-side OAuth 2.0 refresh token with the minimal `drive.file` scope.
# Unset credentials disable archival; the server reports ARCHIVE_UNAVAILABLE.
GOOGLE_DRIVE_CLIENT_ID=
GOOGLE_DRIVE_CLIENT_SECRET=
GOOGLE_DRIVE_REFRESH_TOKEN=
# Optional app-controlled archive folder id.
GOOGLE_DRIVE_FOLDER_ID=

# --- Google OAuth sign-in (Slice 1 follow-up; unset disables the button) ---
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=

# --- Cloudflare Turnstile on guest login (unset = check skipped) ---
# Site key ships to the browser via /health; secret verifies tokens server-side.
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# --- Embeddings for retrieval (Slice 8). Any OpenAI-compatible provider. ---
# The InferHub gateway exposes no embeddings endpoint, so this is configured
# separately from INFERHUB_API_KEY. A provider counts as configured when either a
# key or a base URL is set, so a local keyless server (Ollama, llama.cpp, TEI) works
# with the key left empty. Dimensions must match the vector width in the RAG
# migration (1024); a mismatch fails ingest with EMBEDDING_DIMENSION_MISMATCH.
OCTO_EMBEDDING_API_KEY=
OCTO_EMBEDDING_BASE_URL=http://host.docker.internal:11434/v1
OCTO_EMBEDDING_MODEL=qwen3-embedding:0.6b
OCTO_EMBEDDING_DIMENSIONS=1024

# --- InferHub vision QA (CI only; passed via repository secret) ---
INFERHUB_API_KEY=
INFERHUB_BASE_URL=https://api.inferhub.dev/v1
