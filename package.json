{
  "name": "octo",
  "version": "0.1.0",
  "private": true,
  "description": "Reusable self-hosted control plane for workspaces, files, and agents",
  "type": "module",
  "scripts": {
    "dev": "npm --prefix frontend run dev",
    "build": "npm --prefix frontend run build",
    "server": "tsx src/server/index.ts",
    "production-smoke": "tsx scripts/production-smoke.ts",
    "capture-ops": "tsx scripts/capture-ops.ts",
    "backup": "tsx scripts/octo-backup.ts",
    "sync": "tsx scripts/octo-sync.ts",
    "export-vectors": "tsx scripts/export-vectors.ts",
    "mcp": "tsx scripts/octo-mcp.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1144.0",
    "@aws-sdk/s3-request-presigner": "^3.1144.0",
    "@modelcontextprotocol/sdk": "^1.32.0",
    "@supabase/supabase-js": "^2.117.0",
    "@types/pg": "^8.23.1",
    "falkordb": "^6.8.0",
    "otplib": "^13.5.0",
    "pg": "^8.23.1",
    "sharp": "^0.35.5"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@types/node": "^22.10.0",
    "tsx": "^4.23.15",
    "typescript": "^5.7.0",
    "vite": "^8.3.1",
    "vitest": "^3.0.0"
  }
}
